{
  "name": "chess-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/build.mjs --if-needed",
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc -p cloudflare/tsconfig.json --noEmit",
    "test": "node --test cloudflare/tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.8.3",
    "wrangler": "^4.148.0",
    "ws": "^8.21.0"
  }
}
