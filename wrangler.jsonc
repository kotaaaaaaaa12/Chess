{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chess-master",
  "main": "cloudflare/src/index.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "tsconfig": "cloudflare/tsconfig.json",
  "assets": {
    "directory": "frontend/out", "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "chess-db",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "cloudflare/migrations"
  }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ChessRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChessRoom"] }],
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true },
  "vars": { "ROOM_LOCATION_HINT": "apac" }
}
