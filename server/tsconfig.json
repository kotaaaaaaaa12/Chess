{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/chess/*": ["../frontend/src/lib/chess/*"],
      "@/lib/settings/*": ["../frontend/src/lib/settings/*"]
    }
  },
  "include": ["src/**/*", "drizzle.config.ts"]
}
